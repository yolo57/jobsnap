# JobSnap Environment Variables
# Add ALL of these in Vercel Dashboard → Project → Settings → Environment Variables

# OpenAI - get at platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Supabase - get at supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe - get at dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs - create at dashboard.stripe.com/products
STRIPE_PRO_PRICE_ID=price_your-pro-price-id
STRIPE_PREMIUM_PRICE_ID=price_your-premium-price-id

# App URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Email (for follow-ups) - use Gmail App Password or SendGrid
EMAIL_FROM=noreply@yourcompany.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-app-password

# Cron secret - any random string, protects /api/followups/process from public calls
CRON_SECRET=your-random-secret-here

# Sentry (error tracking) - get at sentry.io -> your project -> Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Optional, only needed for source-map upload in CI/Vercel builds:
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-auth-token

# PostHog (analytics) - get at posthog.com -> your project -> Settings -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_your-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
